# Bot token from @BotFather (required, except with --dry-run)
TELEGRAM_BOT_TOKEN=
# Target chat id, from https://api.telegram.org/bot<TOKEN>/getUpdates (required, except with --dry-run)
TELEGRAM_CHAT_ID=

# Tires on the car at first start: summer or winter. Ignored once the app has saved its state.
CURRENT_TIRES=summer

# Mean daily temperature threshold in °C, shared by both alerts
THRESHOLD_C=7
# Minimum length of the cold or warm stretch in the forecast, in days
MIN_DAYS=3
# Months in which summer alerts may be sent, e.g. 3-9 or 4,5,6
SUMMER_ALERT_MONTHS=3-9
# Hour of the daily check, always Europe/Warsaw time
CHECK_HOUR=7

# Location (defaults to Gdynia)
LAT=54.5189
LON=18.5305
LOCATION_NAME=Gdynia
